          "from": {
            "type": "repo",
            "repo": "DrFlGd/Print-Factory"
          },
          "entry": "index.html",
          "build": {
            "output": "dist",
            "steps": [
              [
                "npm",
                "run",
                "build"
              ]
            ]
          }
        },
        {
          "kind": "bundle",
          "label": "Install release",
          "from": {
            "type": "release",
            "tag": "web-*",
