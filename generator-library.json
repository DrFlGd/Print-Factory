{
  "$schema": "https://raw.githubusercontent.com/DrFlGd/Generator-Library/main/schema/collection.schema.json",
  "id": "print-factory",
  "name": "Print Factory",
  "repo": "DrFlGd/Print-Factory",
  "defaults": {
    "license": "MIT",
    "author": "Jerred",
    "tags": [
      "print-factory"
    ],
    "pricing": "free",
    "openSource": true
  },
  "generators": [
    {
      "id": "print-factory",
      "name": "Print Factory",
      "summary": "All 3 Print Factory generators in one app.",
      "process": "tool",
      "category": "collections",
      "icon": "apps/hub/public/favicon.svg",
      "distributions": [
        {
          "kind": "bundle",
          "label": "Build from source",
          "from": {
            "type": "repo",
            "repo": "DrFlGd/Print-Factory"
          },
          "entry": "index.html",
          "build": {
            "output": "dist",
            "steps": [
              [
                "npm",
                "run",
                "build"
              ]
            ]
          }
        },
        {
          "kind": "bundle",
          "label": "Install release",
          "from": {
            "type": "release",
            "tag": "web-*",
            "asset": "print-factory-web-*.zip"
          },
          "entry": "index.html"
        }
      ]
    },
    {
      "id": "pf-house-number",
      "name": "House Number",
      "version": "1.0.0",
      "summary": "House and office number signs: one or two lines at their own sizes, plates, bands, frames, inlaid or raised numbers, and hidden keyhole mounts.",
      "process": "3d-print",
      "exports": [
        "3mf",
        "stl",
        "obj"
      ],
      "distributions": [
        {
          "kind": "bundle",
          "label": "Build from source",
          "from": {
            "type": "repo",
            "repo": "DrFlGd/Print-Factory"
          },
          "entry": "index.html#/m/house-number",
          "build": {
            "output": "dist",
            "steps": [
              [
                "npm",
                "run",
                "build"
              ]
            ]
          }
        },
        {
          "kind": "bundle",
          "label": "Install release",
          "from": {
            "type": "release",
            "tag": "web-*",
            "asset": "print-factory-web-*.zip"
          },
          "entry": "index.html#/m/house-number"
        }
      ],
      "category": "signs-text",
      "tags": [
        "sign",
        "house number",
        "door",
        "plaque",
        "text"
      ],
      "license": "MIT",
      "supersedes": [
        "house-number"
      ]
    },
    {
      "id": "pf-name-keychain",
      "name": "Name Keychain",
      "version": "1.0.0",
      "summary": "Name keychains and tags in any of 64 fonts: one, two or three colours, raised, inlaid or engraved letters, with or without an AMS.",
      "process": "3d-print",
      "exports": [
        "3mf",
        "stl",
        "obj"
      ],
      "distributions": [
        {
          "kind": "bundle",
          "label": "Build from source",
          "from": {
            "type": "repo",
            "repo": "DrFlGd/Print-Factory"
          },
          "entry": "index.html#/m/name-keychain",
          "build": {
            "output": "dist",
            "steps": [
              [
                "npm",
                "run",
                "build"
              ]
            ]
          }
        },
        {
          "kind": "bundle",
          "label": "Install release",
          "from": {
            "type": "release",
            "tag": "web-*",
            "asset": "print-factory-web-*.zip"
          },
          "entry": "index.html#/m/name-keychain"
        }
      ],
      "category": "keychains",
      "tags": [
        "keychain",
        "name",
        "text",
        "tag",
        "multicolour"
      ],
      "license": "MIT",
      "supersedes": [
        "name-keychain"
      ]
    },
    {
      "id": "pf-pen-topper",
      "name": "Pen Topper",
      "version": "1.0.0",
      "summary": "Name toppers that push onto a pen, pencil, stylus, straw or drawstring: a socket sized to what you own, with grip ribs, in any font, with a symbol.",
      "process": "3d-print",
      "exports": [
        "3mf",
        "stl",
        "obj"
      ],
      "distributions": [
        {
          "kind": "bundle",
          "label": "Build from source",
          "from": {
            "type": "repo",
            "repo": "DrFlGd/Print-Factory"
          },
          "entry": "index.html#/m/pen-topper",
          "build": {
            "output": "dist",
            "steps": [
              [
                "npm",
                "run",
                "build"
              ]
            ]
          }
        },
        {
          "kind": "bundle",
          "label": "Install release",
          "from": {
            "type": "release",
            "tag": "web-*",
            "asset": "print-factory-web-*.zip"
          },
          "entry": "index.html#/m/pen-topper"
        }
      ],
      "category": "desk-home",
      "tags": [
        "pen",
        "pencil",
        "topper",
        "name",
        "school",
        "gift"
      ],
      "license": "MIT",
      "supersedes": [
        "pen-topper"
      ]
    }
  ]
}
