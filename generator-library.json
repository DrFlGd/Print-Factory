{
  "$schema": "https://raw.githubusercontent.com/DrFlGd/Generator-Library/main/schema/collection.schema.json",
  "id": "print-factory",
  "name": "Print Factory",
  "repo": "DrFlGd/Print-Factory",
  "defaults": {
    "license": "MIT",
    "author": "Jerred",
    "tags": [
      "print-factory"
    ],
    "pricing": "free",
    "openSource": true
  },
  "generators": [
    {
      "id": "print-factory",
      "name": "Print Factory",
      "summary": "All 7 Print Factory generators in one app.",
      "process": "tool",
      "category": "collections",
      "icon": "apps/hub/public/favicon.svg",
      "distributions": [
        {
          "kind": "bundle",
          "label": "Build from source",
          "from": {
            "type": "repo",
            "repo": "DrFlGd/Print-Factory"
          },
          "entry": "index.html",
          "build": {
            "output": "dist",
            "steps": [
              [
                "npm",
                "run",
                "build"
              ]
            ]
          }
        },
        {
          "kind": "bundle",
          "label": "Install release",
          "from": {
            "type": "release",
            "tag": "web-*",
            "asset": "print-factory-web-*.zip"
          },
          "entry": "index.html"
        }
      ]
    },
    {
      "id": "pf-house-number",
      "name": "House Number",
      "version": "1.0.0",
      "summary": "House and office number signs: one or two lines at their own sizes, plates, bands, frames, inlaid or raised numbers, and hidden keyhole mounts.",
      "process": "3d-print",
      "exports": [
        "3mf",
        "stl",
        "obj"
