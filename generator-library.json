  "generators": [
    {
      "id": "print-factory",
      "name": "Print Factory",
      "summary": "All 23 Print Factory generators in one app.",
      "process": "tool",
      "category": "collections",
      "icon": "apps/hub/public/favicon.svg",
      "distributions": [
        {
          "kind": "bundle",
          "label": "Build from source",
          "from": {
            "type": "repo",
            "repo": "DrFlGd/Print-Factory"
          },
          "entry": "index.html",
          "build": {
            "output": "dist",
            "steps": [
              [
                "npm",
                "run",
                "build"
              ]
            ]
          }
        },
        {
          "kind": "bundle",
          "label": "Install release",
          "from": {
            "type": "release",
            "tag": "web-*",
            "asset": "print-factory-web-*.zip"
          },
          "entry": "index.html"
        }
      ]
    },
