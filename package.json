{
  "name": "print-factory",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/gen-registry.mjs && vite --config apps/hub/vite.config.ts",
    "build": "node tools/gen-registry.mjs && vite build --config apps/hub/vite.config.ts",
    "preview": "vite preview --config apps/hub/vite.config.ts",
    "gen": "node tools/gen-registry.mjs",
    "new:module": "node tools/new-module.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "node tools/browser-check.mjs",
    "check": "node tools/gen-registry.mjs --check && tsc -p tsconfig.json && vitest run"
  },
  "devDependencies": {
    "@pf/core": "workspace:*",
    "@pf/engine-manifold": "workspace:*",
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
