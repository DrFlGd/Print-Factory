{
  "groups": [
    "Design",
    "Model",
    "Cap",
    "Keys",
    "Body",
    "Fit",
    "Colours"
  ],
  "parameters": [
    {
      "name": "source",
      "label": "Design",
      "type": "enum",
      "default": "picture",
      "group": "Design",
      "widget": "segmented",
      "options": [
        {
          "value": "picture",
          "label": "Picture"
        },
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "model",
          "label": "3D model",
          "description": "Your own STL, 3MF or OBJ made into a clicker."
        },
        {
          "value": "none",
          "label": "Plain"
        }
      ]
    },
    {
      "name": "legends",
      "label": "Text",
      "type": "string",
      "default": "A",
      "maxLength": 80,
      "group": "Design",
      "showIf": "source == 'text'",
      "description": "With several keys, separate each key's text with commas: A,B,C."
    },
    {
      "name": "font",
      "label": "Font",
      "type": "font",
      "default": "luckiest-guy",
      "group": "Design",
      "showIf": "source == 'text'"
    },
    {
      "name": "textColor",
      "label": "Text colour",
      "type": "color",
      "default": [
        22,
        22,
        22
      ],
      "group": "Design",
      "showIf": "source == 'text'",
      "palette": [
        [
          22,
          22,
          22
        ],
        [
          247,
          247,
          245
        ],
        [
          200,
          16,
          46
        ],
        [
          10,
          92,
          213
        ],
        [
          245,
          197,
          24
        ],
        [
          0,
          174,
          66
        ]
      ]
    },
    {
      "name": "cutter",
      "label": "Make it click by",
      "type": "enum",
      "default": "slice",
      "group": "Model",
      "options": [
        {
          "value": "slice",
          "label": "Slice",
          "description": "One cut; the top half is the button."
        },
        {
          "value": "stand",
          "label": "Stand",
          "description": "The model rides on a plate in a base; works with any model."
        },
        {
          "value": "button",
          "label": "Button",
          "description": "A button cut into the model's top."
        }
      ],
      "widget": "cards",
      "showIf": "source == 'model'"
    },
    {
      "name": "modelSize",
      "label": "Size",
      "type": "number",
      "default": 45,
      "min": 20,
      "max": 200,
      "step": 1,
      "unit": "mm",
      "group": "Model",
      "showIf": "source == 'model'",
      "description": "The model's longest side."
    },
    {
      "name": "modelUp",
      "label": "Up is",
      "type": "enum",
      "default": "z",
      "group": "Model",
      "options": [
        {
          "value": "z",
          "label": "Z"
        },
        {
          "value": "-z",
          "label": "−Z"
        },
        {
          "value": "y",
          "label": "Y"
        },
        {
          "value": "-y",
          "label": "−Y"
        },
        {
          "value": "x",
          "label": "X"
        },
        {
          "value": "-x",
          "label": "−X"
        }
      ],
      "widget": "segmented",
      "showIf": "source == 'model'",
      "description": "Which of the file's axes points up."
    },
    {
      "name": "modelSpin",
      "label": "Turn",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 345,
      "step": 15,
      "unit": "deg",
      "group": "Model",
      "showIf": "source == 'model'"
    },
    {
      "name": "flatten",
      "label": "Flatten bottom",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "unit": "mm",
      "group": "Model",
      "showIf": "source == 'model'",
      "advanced": true,
      "description": "0 decides: nothing for a model with a flat base, enough for a ball to stand."
    },
    {
      "name": "cutHeight",
      "label": "Cut height",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 200,
      "step": 0.5,
      "unit": "mm",
      "group": "Model",
      "showIf": "source == 'model' && cutter == 'slice'",
      "description": "Above the bottom; 0 finds the cut nearest the middle with room for the switch."
    },
    {
      "name": "hideGap",
      "label": "Hide the gap",
      "type": "boolean",
      "default": true,
      "group": "Model",
      "showIf": "source == 'model' && cutter == 'slice'",
      "description": "A collar of the model's skin hides the switch; the top slides inside it."
    },
    {
      "name": "standShape",
      "label": "Plate",
      "type": "enum",
      "default": "circle",
      "group": "Model",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "outline",
          "label": "Footprint"
        }
      ],
      "widget": "segmented",
      "showIf": "source == 'model' && cutter == 'stand'"
    },
    {
      "name": "standMargin",
      "label": "Plate margin",
      "type": "number",
      "default": 2.5,
      "min": 0,
      "max": 20,
      "step": 0.5,
      "unit": "mm",
      "group": "Model",
      "showIf": "source == 'model' && cutter == 'stand'"
    },
    {
      "name": "buttonShape",
      "label": "Button",
      "type": "enum",
      "default": "round",
      "group": "Model",
      "options": [
        {
          "value": "round",
          "label": "Round"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "widget": "segmented",
      "showIf": "source == 'model' && cutter == 'button'"
    },
    {
      "name": "buttonSize",
      "label": "Button size",
      "type": "number",
      "default": 24,
      "min": 17,
      "max": 60,
      "step": 0.5,
      "unit": "mm",
      "group": "Model",
      "showIf": "source == 'model' && cutter == 'button'",
      "description": "At least 23.5 mm round or 16.6 mm square, so the switch goes in through it."
    },
    {
      "name": "buttonRaise",
      "label": "Raise",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 4,
      "step": 0.1,
      "unit": "mm",
      "group": "Model",
      "showIf": "source == 'model' && cutter == 'button'",
      "description": "How far it stands proud at rest; 0 is flush."
    },
    {
      "name": "buttonX",
      "label": "Across",
      "type": "number",
      "default": 0,
      "min": -100,
      "max": 100,
      "step": 0.5,
      "unit": "mm",
      "group": "Model",
      "showIf": "source == 'model' && cutter == 'button'",
      "advanced": true,
      "description": "0 and 0 place it on the top automatically."
    },
    {
      "name": "buttonY",
      "label": "Back",
      "type": "number",
      "default": 0,
      "min": -100,
      "max": 100,
      "step": 0.5,
      "unit": "mm",
      "group": "Model",
      "showIf": "source == 'model' && cutter == 'button'",
      "advanced": true
    },
    {
      "name": "shape",
      "label": "Cap shape",
      "type": "enum",
      "default": "rounded-square",
      "group": "Cap",
      "options": [
        {
          "value": "outline",
          "label": "Follow the picture"
        },
        {
          "value": "rounded-square",
          "label": "Rounded square"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "squircle",
          "label": "Squircle"
        },
        {
          "value": "hexagon",
          "label": "Hexagon"
        },
        {
          "value": "octagon",
          "label": "Octagon"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "shield",
          "label": "Shield"
        },
        {
          "value": "pill",
          "label": "Pill"
        },
        {
          "value": "oval",
          "label": "Oval"
        },
        {
          "value": "teardrop",
          "label": "Teardrop"
        }
      ],
      "showIf": "source != 'model'"
    },
    {
      "name": "size",
      "label": "Cap size",
      "type": "number",
      "default": 35,
      "min": 20,
      "max": 120,
      "step": 0.5,
      "unit": "mm",
      "group": "Cap",
      "description": "The longest side. Grown if the switch would not fit under it.",
      "showIf": "source != 'model'"
    },
    {
      "name": "imageMargin",
      "label": "Frame",
      "type": "number",
      "default": 2,
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "mm",
      "group": "Cap",
      "showIf": "source != 'none' && source != 'model'"
    },
    {
      "name": "imageDepth",
      "label": "Inlay depth",
      "type": "number",
      "default": 0.8,
      "min": 0.2,
      "max": 1.6,
      "step": 0.1,
      "unit": "mm",
      "group": "Cap",
      "showIf": "source != 'none' && source != 'model'"
    },
    {
      "name": "bleed",
      "label": "Colour overlap",
      "type": "number",
      "default": 0.1,
      "min": 0,
      "max": 0.6,
      "step": 0.02,
      "unit": "mm",
      "group": "Cap",
      "advanced": true,
      "showIf": "source == 'picture'"
    },
    {
      "name": "keys",
      "label": "Keys",
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 12,
      "step": 1,
      "group": "Keys",
      "description": "Each key has its own switch and cap in one body.",
      "showIf": "source != 'model'"
    },
    {
      "name": "layout",
      "label": "Layout",
      "type": "enum",
      "default": "row",
      "group": "Keys",
      "widget": "segmented",
      "showIf": "(keys > 1) && source != 'model'",
      "options": [
        {
          "value": "row",
          "label": "Row"
        },
        {
          "value": "column",
          "label": "Column"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ]
    },
    {
      "name": "columns",
      "label": "Columns",
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 6,
      "step": 1,
      "group": "Keys",
      "showIf": "(keys > 1 && layout == 'grid') && source != 'model'"
    },
    {
      "name": "keySpacing",
      "label": "Wall between keys",
      "type": "number",
      "default": 2,
      "min": 1.6,
      "max": 15,
      "step": 0.2,
      "unit": "mm",
      "group": "Keys",
      "showIf": "(keys > 1) && source != 'model'"
    },
    {
      "name": "border",
      "label": "Border",
      "type": "number",
      "default": 3,
      "min": 1.2,
      "max": 15,
      "step": 0.2,
      "unit": "mm",
      "group": "Body",
      "description": "The wall round the cap.",
      "showIf": "(source != 'model' || cutter == 'stand')"
    },
    {
      "name": "capProud",
      "label": "Cap stands proud",
      "type": "number",
      "default": 3.6,
      "min": 0.5,
      "max": 4,
      "step": 0.1,
      "unit": "mm",
      "group": "Body",
      "description": "About the switch travel, so a full press takes the cap flush.",
      "showIf": "(source != 'model' || cutter == 'stand')"
    },
    {
      "name": "keychain",
      "label": "Keyring",
      "type": "enum",
      "default": "none",
      "group": "Body",
      "widget": "segmented",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "loop",
          "label": "Loop"
        },
        {
          "value": "hole",
          "label": "Hole"
        }
      ],
      "showIf": "(source != 'model' || cutter == 'stand')"
    },
    {
      "name": "keychainSide",
      "label": "On the",
      "type": "enum",
      "default": "top",
      "group": "Body",
      "widget": "segmented",
      "showIf": "(keychain != 'none') && (source != 'model' || cutter == 'stand')",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "name": "tolerance",
      "label": "Cap clearance",
      "type": "number",
      "default": 0.4,
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "unit": "mm",
      "group": "Fit",
      "description": "Gap round the cap in its well."
    },
    {
      "name": "stemFit",
      "label": "Stem clearance",
      "type": "number",
      "default": 0,
      "min": -0.4,
      "max": 0.4,
      "step": 0.02,
      "unit": "mm",
      "group": "Fit",
      "description": "+ if the cap is hard to push onto the switch, − if it is loose."
    },
    {
      "name": "socketFit",
      "label": "Plate cutout",
      "type": "number",
      "default": 0.1,
      "min": -0.2,
      "max": 0.5,
      "step": 0.05,
      "unit": "mm",
      "group": "Fit",
      "advanced": true,
      "description": "Added to the 14 mm switch cutout. Raise it if the switch will not go in."
    },
    {
      "name": "capColor",
      "label": "Cap",
      "type": "color",
      "default": [
        247,
        247,
        245
      ],
      "group": "Colours",
      "palette": [
        [
          247,
