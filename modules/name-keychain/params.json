{
  "groups": ["Text", "Shape", "Layers", "Key ring", "Colours", "Printing"],
  "parameters": [
    { "name": "text", "label": "Text", "type": "string", "default": "Print Factory", "maxLength": 60, "multiline": true, "group": "Text", "description": "Up to three lines. Accents, Greek and Cyrillic fall back to Noto Sans when the font lacks them." },
    { "name": "font", "label": "Font", "type": "font", "default": "luckiest-guy", "group": "Text" },
    { "name": "letterHeight", "label": "Letter height", "type": "number", "default": 12, "min": 5, "max": 40, "step": 0.5, "unit": "mm", "group": "Text", "description": "Height of a capital letter." },
    { "name": "letterSpacing", "label": "Letter spacing", "type": "number", "default": 0, "min": -3, "max": 6, "step": 0.1, "unit": "mm", "group": "Text", "advanced": true },
    { "name": "lineHeight", "label": "Line spacing", "type": "number", "default": 1.15, "min": 0.8, "max": 2, "step": 0.05, "unit": "x", "group": "Text", "advanced": true },
    { "name": "align", "label": "Alignment", "type": "enum", "default": "center", "group": "Text", "advanced": true, "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" }] },

    { "name": "shape", "label": "Shape", "type": "enum", "default": "outline", "group": "Shape", "widget": "cards", "options": [
      { "value": "outline", "label": "Follow the letters", "description": "Bubble outline around the text" },
      { "value": "rounded", "label": "Rounded plate", "description": "Rectangle with rounded corners" },
      { "value": "pill", "label": "Pill", "description": "Fully rounded ends" },
      { "value": "none", "label": "Letters only", "description": "No plate; letters joined by a bar" }
    ] },
    { "name": "padding", "label": "Margin around text", "type": "number", "default": 3, "min": 1, "max": 12, "step": 0.1, "unit": "mm", "group": "Shape", "showIf": "shape != 'none'" },
    { "name": "cornerRadius", "label": "Corner radius", "type": "number", "default": 3, "min": 0, "max": 20, "step": 0.5, "unit": "mm", "group": "Shape", "showIf": "shape == 'rounded'" },
    { "name": "smoothing", "label": "Outline smoothing", "type": "number", "default": 1.5, "min": 0, "max": 6, "step": 0.1, "unit": "mm", "group": "Shape", "showIf": "shape == 'outline'", "description": "Rounds the inside corners of the bubble outline." },
    { "name": "baseThickness", "label": "Plate thickness", "type": "number", "default": 2.4, "min": 0.8, "max": 8, "step": 0.1, "unit": "mm", "group": "Shape" },

    { "name": "layers", "label": "Colours", "type": "enum", "default": 2, "group": "Layers", "widget": "segmented", "options": [{ "value": 1, "label": "One" }, { "value": 2, "label": "Two" }, { "value": 3, "label": "Three" }], "description": "Two: plate and letters. Three adds a border around the plate." },
    { "name": "textStyle", "label": "Letters", "type": "enum", "default": "raised", "group": "Layers", "widget": "segmented", "options": [{ "value": "raised", "label": "Raised" }, { "value": "inlay", "label": "Inlaid" }, { "value": "engraved", "label": "Engraved" }] },
    { "name": "textHeight", "label": "Letter height above plate", "type": "number", "default": 1.2, "min": 0.2, "max": 6, "step": 0.1, "unit": "mm", "group": "Layers", "showIf": "textStyle == 'raised'" },
    { "name": "depth", "label": "Depth", "type": "number", "default": 0.6, "min": 0.2, "max": 3, "step": 0.1, "unit": "mm", "group": "Layers", "showIf": "textStyle != 'raised'", "description": "How deep the letters go into the plate." },
    { "name": "borderWidth", "label": "Border width", "type": "number", "default": 1.6, "min": 0.4, "max": 6, "step": 0.1, "unit": "mm", "group": "Layers", "showIf": "layers == 3" },
    { "name": "borderHeight", "label": "Border height", "type": "number", "default": 1.2, "min": 0.2, "max": 6, "step": 0.1, "unit": "mm", "group": "Layers", "showIf": "layers == 3" },

    { "name": "ring", "label": "Ring", "type": "enum", "default": "tab", "group": "Key ring", "widget": "segmented", "options": [{ "value": "tab", "label": "Tab" }, { "value": "hole", "label": "Hole" }, { "value": "none", "label": "None" }], "description": "A tab sticks out of the plate; a hole is cut inside it." },
    { "name": "ringSide", "label": "Position", "type": "enum", "default": "left", "group": "Key ring", "widget": "segmented", "showIf": "ring != 'none'", "options": [{ "value": "left", "label": "Left" }, { "value": "top", "label": "Top" }, { "value": "right", "label": "Right" }] },
    { "name": "holeDiameter", "label": "Hole diameter", "type": "number", "default": 4.5, "min": 2, "max": 12, "step": 0.1, "unit": "mm", "group": "Key ring", "showIf": "ring != 'none'" },
    { "name": "ringWall", "label": "Ring wall", "type": "number", "default": 2.4, "min": 1, "max": 6, "step": 0.1, "unit": "mm", "group": "Key ring", "showIf": "ring != 'none'" },

    { "name": "baseColor", "label": "Plate", "type": "color", "default": [24, 24, 28], "group": "Colours", "palette": [[24, 24, 28], [245, 245, 245], [200, 30, 45], [0, 92, 175], [0, 140, 80], [255, 196, 0], [240, 110, 170], [120, 70, 170]] },
    { "name": "textColor", "label": "Letters", "type": "color", "default": [245, 245, 245], "group": "Colours", "showIf": "layers >= 2", "palette": [[245, 245, 245], [24, 24, 28], [255, 196, 0], [200, 30, 45], [0, 92, 175], [0, 140, 80], [240, 110, 170], [190, 190, 195]] },
    { "name": "borderColor", "label": "Border", "type": "color", "default": [255, 196, 0], "group": "Colours", "showIf": "layers == 3", "palette": [[255, 196, 0], [245, 245, 245], [24, 24, 28], [200, 30, 45], [0, 92, 175], [0, 140, 80], [240, 110, 170], [190, 190, 195]] },

    { "name": "ams", "label": "Printer swaps filament (AMS, MMU)", "type": "boolean", "default": true, "group": "Printing", "description": "Off: colours change by height, with a pause to swap filament. Only raised letters and borders work that way." }
  ]
}
