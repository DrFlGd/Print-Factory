        ]
      ]
    },
    {
      "name": "layerHeight",
      "label": "Layer height",
      "type": "number",
      "default": 0.2,
      "min": 0.08,
      "max": 0.32,
      "step": 0.02,
      "unit": "mm",
      "group": "Sheet",
      "description": "Use the same for the first layer: the hinges are the first layer."
    },
    {
      "name": "sheetLayers",
      "label": "Sheet layers",
      "type": "integer",
      "default": 2,
      "min": 2,
      "max": 6,
      "step": 1,
      "group": "Sheet",
      "description": "2 \u00d7 0.2 mm is about 300 gsm card. More is stiffer and harder to fold."
    },
    {
      "name": "hingeLayers",
      "label": "Hinge layers",
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 3,
      "step": 1,
      "group": "Sheet",
      "advanced": true
    },
    {
      "name": "grooveWidth",
      "label": "Groove width",
      "type": "number",
      "default": 1.2,
      "min": 0.6,
      "max": 4,
      "step": 0.1,
      "unit": "mm",
      "group": "Sheet",
      "advanced": true,
      "description": "Never less than twice the sheet thickness."
    },
    {
      "name": "cutGap",
      "label": "Cut width",
      "type": "number",
      "default": 0.6,
      "min": 0.3,
      "max": 2,
      "step": 0.05,
      "unit": "mm",
      "group": "Sheet",
      "advanced": true,
      "description": "Gap between panels that are not folded together."
    },
    {
      "name": "foldPreview",
      "label": "Folded preview",
      "type": "number",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "group": "Preview",
      "description": "A folded copy beside the sheet. Preview only; never exported."
    }
  ]
}