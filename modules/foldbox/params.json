        ]
      ]
    },
    {
      "name": "artColor",
      "label": "Logo",
      "type": "color",
      "default": [
        200,
        16,
        46
      ],
      "group": "Colours",
      "showIf": "art != 'none'",
      "palette": [
        [
          200,
          16,
          46
        ],
        [
          22,
          22,
          22
        ],
        [
          247,
          247,
          245
        ],
        [
