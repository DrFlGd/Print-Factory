{
  "groups": [
    "Die",
    "Panels",
    "Legends",
    "Switch fit"
  ],
  "parameters": [
    {
      "name": "die",
      "label": "Die",
      "type": "enum",
      "default": "d6",
      "group": "Die",
      "options": [
        {
          "value": "d4",
          "label": "D4"
        },
        {
          "value": "d6",
          "label": "D6"
        },
        {
          "value": "d8",
          "label": "D8"
        },
        {
          "value": "d10",
          "label": "D10"
        },
        {
          "value": "d12",
          "label": "D12"
        },
        {
          "value": "d20",
          "label": "D20"
        }
      ]
    },
    {
      "name": "coreRadius",
      "label": "Core radius (0 = automatic minimum)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 180,
      "step": 1,
      "unit": "mm",
      "group": "Die",
      "description": "Independent of panel width. 0 uses the minimum radius needed for the switch hardware and chosen die type; increase it to create a larger centre. Oversized panels warn instead of resizing the core."
    },
    {
      "name": "preview",
      "label": "Show assembled die beside print layout",
      "type": "boolean",
      "default": false,
      "group": "Die"
    },
    {
      "name": "shape",
      "label": "Panel outline",
      "type": "enum",
      "default": "rounded-square",
      "group": "Panels",
      "options": [
        {
          "value": "face",
          "label": "Match die face"
        },
        {
          "value": "rounded-square",
          "label": "Rounded square"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "hexagon",
          "label": "Hexagon"
        }
      ]
    },
    {
      "name": "profile",
      "label": "Top contour",
      "type": "enum",
      "default": "flat",
      "group": "Panels",
      "options": [
        {
          "value": "flat",
          "label": "Flat"
        },
        {
          "value": "dished",
          "label": "Dished"
        },
        {
          "value": "bevel",
          "label": "Beveled"
        }
      ]
    },
    {
      "name": "size",
      "label": "Panel width",
      "type": "number",
      "default": 19,
      "group": "Panels",
      "min": 16,
      "max": 60,
      "step": 0.5,
      "unit": "mm",
      "description": "Panel width, independent of the die body. Large panels may overhang; increase Core radius separately if needed."
    },
    {
      "name": "recessed",
      "label": "Recess panel over switch",
      "type": "boolean",
      "default": false,
      "group": "Panels",
      "description": "Lower the switch into the die and extend a hollow rim around the housing."
    },
    {
      "name": "recessDepth",
      "label": "Recess depth",
      "type": "number",
      "default": 5,
      "min": 1,
      "max": 6,
      "step": 0.5,
      "unit": "mm",
      "group": "Panels",
      "showIf": "recessed"
    },
    {
      "name": "legend",
      "label": "Face labels",
      "type": "enum",
      "default": "numbers",
      "group": "Legends",
      "options": [
        {
          "value": "numbers",
          "label": "Numbers"
        },
        {
          "value": "letters",
          "label": "Letters"
        },
        {
          "value": "custom",
          "label": "Custom"
        },
        {
          "value": "blank",
          "label": "Blank"
        }
      ]
    },
    {
      "name": "labels",
      "label": "One label per line",
      "type": "string",
      "default": "",
      "group": "Legends",
      "multiline": true,
      "maxLength": 1000,
      "showIf": "legend == 'custom'",
      "description": "Lines follow panel order. Leave a line empty for a blank panel."
    },
    {
      "name": "font",
      "label": "Label font",
      "type": "font",
      "default": "space-mono-700",
      "group": "Legends",
      "showIf": "legend != 'blank'"
    },
    {
      "name": "switchRecessed",
      "label": "Recess switch into die face",
      "type": "boolean",
      "default": false,
      "group": "Switch fit",
      "description": "Cut a panel-shaped pocket into each face, leaving a raised border around the edges."
    },
    {
      "name": "switchDepth",
      "label": "Switch recess depth",
      "type": "number",
      "default": 12,
      "min": 1,
      "max": 16,
      "step": 0.5,
      "unit": "mm",
      "group": "Switch fit",
      "showIf": "switchRecessed",
      "description": "Additional depth below the face. Combines with the panel recess when both are enabled."
    },
    {
      "name": "socketFit",
      "label": "Switch cutout allowance",
      "type": "number",
      "default": 0.15,
      "group": "Switch fit",
      "min": 0,
      "max": 0.5,
      "step": 0.05,
      "unit": "mm"
    },
    {
      "name": "stemFit",
      "label": "Stem socket allowance",
      "type": "number",
      "default": 0.1,
      "group": "Switch fit",
      "min": -0.15,
      "max": 0.4,
      "step": 0.05,
      "unit": "mm"
    }
  ]
}
